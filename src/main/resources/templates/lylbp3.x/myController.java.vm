/**
 * <p>
 * $!{table.comment} 前端控制器
 * </p>
 *
 * @author ${author}
 * @since ${date}
 */
@Validated
#if(${restControllerStyle})
@RestController
#else
@Controller
#end
@RequestMapping("#if(${package.ModuleName})/${package.ModuleName}#end/#if(${controllerMappingHyphenStyle})${controllerMappingHyphen}#else${table.entityPath}#end")
#if(${springdoc})
@Tag(name = "$!{table.comment}")
#elseif(${swagger})
@Api(tags = "$!{table.comment}")
#end
#if(${kotlin})
        class ${table.controllerName}#if(${superControllerClass}) : ${superControllerClass}()#end

#else
    #if(${superControllerClass})
            public class ${table.controllerName} extends ${superControllerClass} {
    #else
            public class ${table.controllerName} {
    #end

        @Resource
        private ${table.serviceName}  ${table.entityPath}Service;

    #if(${cfg.QueryFormSupport} || ${cfg.AddFormSupport} || ${cfg.UpdateFormSupport})
            @Resource
            private ${entity}ConvertMapper ${table.entityPath}ConvertMapper;
    #end
        /**
         * 获取数据分页列表
         *
         * @author ${author}
         * @since   ${date}
         * @return ResResult<PageData <${entity}VO>>
         */
        @GetMapping(value = "/pageList")
            #if(${springdoc})
            @Operation(summary = "获取分页列表")
            #elseif(${swagger})
            @ApiOperation("获取分页列表")
            #end
            #if(${cfg.QueryFormSupport})
            public ResResult<PageData<${entity}VO>> pageList(${entity}QueryForm form, PageQueryDTO pageQueryDTO) {
                    ${entity}QueryDTO dto = ${table.entityPath}ConvertMapper.convert(form);
            #else
                public ResResult<PageData<${entity}VO>> pageList(${entity}QueryDTO dto, PageQueryDTO pageQueryDTO) {
            #end
            Page<${entity}VO> page = MybatisUtil.getMybatisPlusPage(pageQueryDTO, ${entity}VO.class);

            page.setRecords(${table.entityPath}Service.get${entity}VOList(page, dto));

            return ResResultUtil.makePageRsp(page.getRecords(), page.getTotal(), page.getCurrent(), page.getSize());
        }

            /**
             * 根据主键获取信息
             *
             * @author ${author}
             * @since ${date}
             * @return ResResult<${entity}VO>
             */
            @GetMapping(value = "/{${keyPropertyName}}")
                #if(${springdoc})
                @Operation(summary = "根据主键获取信息")
                #elseif(${swagger})
                @ApiOperation("根据主键获取信息")
                #end
            public ResResult<${entity}VO> info(@PathVariable @NotBlank String ${keyPropertyName}) {
            return ResResultUtil.success(${table.entityPath}Service.get${entity}VO(
                        ${entity}QueryDTO::get${keyCapitalName} , ${keyPropertyName}));
        }


            /**
             * 添加
             *
             * @author ${author}
             * @since   ${date}
             * @return ResResult<Boolean>
             */
        @PostMapping(value = "/add")
            #if(${springdoc})
            @Operation(summary = "添加")
            #elseif(${swagger})
            @ApiOperation("添加")
            #end
            #if(${cfg.AddFormSupport})
                public ResResult<Boolean> add(@RequestBody @Valid ${entity}CreateForm form) {
                    ${entity}CreateDTO dto = ${table.entityPath}ConvertMapper.convert(form);
            #else
                public ResResult<Boolean> add(@RequestBody @Valid ${entity}CreateDTO dto) {
            #end

            return ResResultUtil.success(${table.entityPath}Service.add(dto));
        }

            /**
             * 编辑
             *
             * @author ${author}
             * @since   ${date}
             * @return ResResult<Boolean>
             */
        @PutMapping(value = "/update")
            #if(${springdoc})
            @Operation(summary = "编辑")
            #elseif(${swagger})
            @ApiOperation("编辑")
            #end
            #if(${cfg.UpdateFormSupport})
                public ResResult<Boolean> update (@RequestBody @Valid ${entity}UpdateForm form){
                    ${entity}UpdateDTO dto = ${table.entityPath}ConvertMapper.convert(form);
            #else
                public ResResult<Boolean> update (@RequestBody @Valid ${entity}UpdateDTO dto){
            #end
            return ResResultUtil.success(${table.entityPath}Service.update(dto));
        }

            /**
             * 通过主键批量删除
             *
             * @author ${author}
             * @since   ${date}
             * @return ResResult<Boolean>
             */
        @DeleteMapping(value = "/batchDelete")
            #if(${springdoc})
            @Operation(summary = "通过主键批量删除")
            #elseif(${swagger})
            @ApiOperation("通过主键批量删除")
            #end
            public ResResult<Boolean> batchDelete (@RequestBody @NotNull List <${keyPropertyType}> idList) {
            return ResResultUtil.success(${table.entityPath}Service.delByIds(idList));
        }
        }

#end