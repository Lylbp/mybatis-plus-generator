package ${cfg.DTOPackage};
#foreach($pkg in ${importEntityFrameworkPackages})
import ${pkg};
#end
#foreach($pkg in ${importEntityJavaPackages})
import ${pkg};
#end

#if(${entityLombokModel})
import lombok.Data;
import lombok.EqualsAndHashCode;
#end


/**
 * <p>
 * $!{table.comment}修改
 * </p>
 *
 * @author ${author}
 * @since ${date}
 */
    #if(${entityLombokModel})
    @Data
    @ToString
        #if(${superEntityClass})
        @EqualsAndHashCode(callSuper = true)
        #else
        @EqualsAndHashCode(callSuper = false)
        #end
        #if(${chainModel})
        @Accessors(chain = true)
        #end
    #end
    #if(${springdoc} || ${swagger})
        #foreach($an in ${entityClassAnnotations})
            #if($an.displayName.startsWith("@Schema") || $an.displayName.startsWith("@ApiModel"))
                ${an.displayName}
            #end
        #end
    #end
    #if(${entitySerialVersionUID})
    public class ${entity}UpdateDTO implements Serializable {
        #if(${entitySerialAnnotation})
        @Serial
        #end
    private static final long serialVersionUID = 1L;
    #else
    public class ${entity}UpdateDTO {
    #end

    ## ----------  BEGIN 字段循环遍历  ----------
    #foreach($field in ${table.fields})
        #if(${field.keyFlag})
            #if("$!field.comment" != "")
                #if(${springdoc} || ${swagger})
                    #foreach($an in ${field.annotationAttributesList})
                        #if($an.displayName.startsWith("@Schema") || $an.displayName.startsWith("@ApiModel"))
                            ${an.displayName}
                        #end
                    #end
                #else
                /**
                 * ${field.comment}
                 */
                #end
            #end
        private ${field.propertyType} ${field.propertyName};
        #end
    #end
    ## ----------  END 字段循环遍历  ----------

    #if(!${entityLombokModel})
        #foreach($field in ${table.fields})
            #if(${field.keyFlag})
                public ${field.propertyType} get${field.propertyName.substring(0,1).toUpperCase()}${field.propertyName.substring(1)}() {
                    return ${field.propertyName};
                }

                #if(${chainModel})
                public ${entity} set${field.propertyName.substring(0,1).toUpperCase()}${field.propertyName.substring(1)}(${field.propertyType} ${field.propertyName}) {
                #else
                    public void set${field.propertyName.substring(0,1).toUpperCase()}${field.propertyName.substring(1)}
                    (${field.propertyType} ${field.propertyName}) {
                #end
                this.${field.propertyName} = ${field.propertyName};
                #if(${chainModel})
                    return this;
                #end
            }
            #end
        #end
        ## --foreach end---
    #end
}